{
    "name": "myaduan/myaduan",
    "description": "Sistem aduan MyAduan untuk Parlimen Gombak",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {"MyAduan\\": "includes/", "MyAduan\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integration": "bash tests/Integration/run.sh"
    }
}
